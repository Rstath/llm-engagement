# Backend secrets/settings for Render or local testing
APP_SECRET=change-this-to-a-long-random-secret
RESEARCHER_PASSWORD=change-this-password
DB_PATH=human_experiment_data.db

# Put your final GitHub Pages URL here after frontend deploy
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://YOUR_GITHUB_USERNAME.github.io

# Supervisor-hosted OpenAI-compatible / LM Studio endpoint
LLM_BASE_URL=http://150.140.142.76:1234/v1
# Leave blank when the server does not require authentication.
LLM_API_KEY=
# Long inference timeout for the self-hosted endpoint (seconds).
LLM_REQUEST_TIMEOUT_SECONDS=300

# Original experiment model conditions - unchanged.
# The supervisor server must load/expose these model IDs (or exact aliases).
SMALL_LLM_MODEL=lmstudio-community/gemma-3-4B-it-QAT-GGUF
MEDIUM_LLM_MODEL=lmstudio-community/gemma-3-27B-it-qat-GGUF

DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_AGENT_TOKENS=130
TARGET_TOTAL_TURNS=12
